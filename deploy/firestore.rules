// Virgil denies every Firestore client request.
//
// Browser surfaces use the authenticated HTTP service. The Firestore adapter
// runs server-side under the dedicated runtime service account, where Admin SDK
// credentials bypass client security rules. A future direct-client surface must
// introduce collection-specific rules before it can ship.
//
// Deploy from the repository root:
//
//   npx firebase deploy --only firestore:rules --project "$PROJECT_ID"
//
// The project must be registered with Firebase and have
// `firebaserules.googleapis.com` enabled. See `deploy/CLOUD_RUN.md`.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
