    "sections": [{
      "topicId": "judge-topic-rag",
      "heading": "Find the broken link in a RAG answer",
      "summary": "Use one concrete support reply to separate retrieval, grounding and answer-quality failures.",
      "recap": "A RAG result can fail before generation, during evidence use, or in the final answer.",
      "why": "This is Up next because your latest answer treated two different failure modes as one.",
      "body": "Imagine a support answer that confidently says a refund takes 30 days. The source corpus contains the current 14-day policy, but retrieval selects an obsolete pricing page. The generator faithfully repeats what it was given. That is a retrieval failure, not a generation failure. Now keep the correct 14-day policy in context but have the answer claim 30 days: retrieval succeeded and generation failed to use its evidence. The useful diagnostic is therefore two questions in order: did the right evidence enter the context, and did the answer stay faithful to it? This lesson is grounded in your saved RAG overview and evaluation sources, not a generic model memory.",
      "depth": "building",
      "actionMinutes": 2,
      "estimatedMinutes": 5,
      "question": {
        "prompt": "The correct policy is retrieved, but the answer states a different deadline. Which stage failed, and what evidence would prove it?",
        "kind": "free-text",
        "expectedPoints": ["Retrieval succeeded", "Generation or grounding failed", "Compare retrieved context with the final claim"]
      },
      "sourceIds": ["judge-pin-rag-overview:origin", "judge-pin-rag-evaluation:origin"],
      "completed": false,
      "mediumWarning": null
    }],
    "currentSectionIndex": 0,
    "closingNote": "Keep retrieval and answer quality as two inspectable claims.",
    "insufficient": false
  }],
